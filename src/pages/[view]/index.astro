---
import Base from '../../layouts/Base.astro';
import { loadSite } from '../../lib/site-data.js';

export function getStaticPaths() {
  return loadSite().views.map((view) => ({ params: { view: view.slug }, props: { view } }));
}
const { view } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={view.label} current={view.slug}>
  <div id="reader" class="cols left" data-src={`${B}data/${view.slug}.json`} data-slug={view.slug}>
    <aside>
      <details id="cats" class="box" open>
        <summary class="bar">Categories and feeds</summary>
        <div id="tree"></div>
      </details>
      <section class="box side kbd-help" style="--box:#5f5848">
        <h2 class="bar">Keyboard</h2>
        <div class="box-body">
          <p>
            <kbd>j</kbd> <kbd>k</kbd> move &middot; <kbd>o</kbd> open<br />
            <kbd>m</kbd> read/unread &middot; <kbd>s</kbd> save<br />
            <kbd>/</kbd> search &middot; <kbd>Esc</kbd> leave search
          </p>
        </div>
      </section>
    </aside>
    <div>
      <h1>{view.title}</h1>
      <p id="updated"></p>
      <form id="filters" class="searchbar" onsubmit="return false">
        <p>
          <label><span class="q-label">Search</span> <input type="search" id="q" size="26" autocomplete="off" /></label>
          <label>
            in{' '}
            <select id="period">
              <option value="1">24 hours</option>
              <option value="3">3 days</option>
              <option value="7">7 days</option>
              <option value="30">30 days</option>
              <option value="0">everything</option>
            </select>
          </label>
          <label><input type="checkbox" id="unread" /> unread only</label>
          <button type="button" id="mark-all">Mark all as read</button>
        </p>
      </form>
      <p id="scope" aria-live="polite"></p>
      <div id="list"><p>Loading…</p></div>
      <p id="more"></p>
      <p>
        <small>
          Read state is kept in this browser:{' '}
          <a href="#" id="export-read">export</a>{' | '}
          <label class="linkish">import<input type="file" id="import-read" accept="application/json" hidden /></label>.
        </small>
      </p>
    </div>
  </div>
  <script is:inline>
    // The tree sits in a sidebar on wide screens; on phones it starts folded so the items come first.
    if (matchMedia('(max-width: 760px)').matches) document.getElementById('cats').open = false;
  </script>
  <script>
    import { startReader } from '../../scripts/reader.js';
    startReader(document.getElementById('reader'));
  </script>
</Base>
