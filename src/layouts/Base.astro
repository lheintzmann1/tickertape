---
import { loadSite, viewItems } from '../lib/site-data.js';

interface Props {
  title?: string;
  current?: string; // view slug or 'saved' | 'status' | 'admin' | 'home'
}
const { title, current = 'home' } = Astro.props;
const site = loadSite();
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const DAY = 86_400_000;
const updated = site.state.updatedAt ? Date.parse(site.state.updatedAt) : null;
const fresh = (v) => viewItems(v).filter((it) => updated && it.date > updated - DAY).length;
const tools = [
  ['saved', 'Saved'],
  ['status', 'Feed status'],
  ['admin', 'Edit feeds'],
];
const generated = new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
---

<!doctype html>
<html lang={site.config.lang || 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${B}favicon.svg`} type="image/svg+xml" />
    <title>{title ? `${title} - ${site.siteTitle}` : site.siteTitle}</title>
    {site.views.map((v) => <link rel="alternate" type="text/x-opml" title={v.label} href={`${B}opml/${v.file}`} />)}
    <style is:inline>
      :root { color-scheme: dark; }
      body { max-width: 62em; margin: 1em auto; padding: 0 1em; line-height: 1.4; }
      [hidden] { display: none !important; }
      .read .t { color: GrayText; }
      img.mark { vertical-align: -3px; }
    </style>
  </head>
  <body>
    <p>
      <img class="mark" src={`${B}favicon.svg`} width="18" height="18" alt="" />{' '}
      {current === 'home' ? <b>Overview</b> : <a href={B}>Overview</a>}
      {
        site.views.map((v) => (
          <>
            {' | '}
            {current === v.slug ? <b>{v.label}</b> : <a href={`${B}${v.slug}/`}>{v.label}</a>}
            {fresh(v) > 0 && <small title="items from the last 24 hours"> ({fresh(v)})</small>}
          </>
        ))
      }
      {' || '}
      {
        tools.map(([key, label], i) => (
          <>
            {i > 0 && ' | '}
            {current === key ? <b>{label}</b> : <a href={`${B}${key}/`}>{label}</a>}
          </>
        ))
      }
    </p>
    <hr />
    <slot />
    <hr />
    <p>
      <small>
        Tickertape, a static RSS reader built by GitHub Actions. Page generated {generated}.
        {site.repo && <> Repository: <a href={`https://github.com/${site.repo}`}>{site.repo}</a>.</>}
        {' '}OPML: {site.views.map((v, i) => <>{i > 0 && ', '}<a href={`${B}opml/${v.file}`}>{v.file}</a></>)}.
      </small>
    </p>
  </body>
</html>
